# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.
# Nada aqui é obrigatório: sem .env, o docker compose sobe com os valores padrão.

# Chave privada RSA (formato PEM) que assina os tokens. Chega só ao serviço de Usuários.
# Se ficar vazia, o serviço gera uma na primeira subida e a guarda no próprio banco.
# Para gerar uma: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Aqui, numa linha só, com \n no lugar de cada quebra de linha.
JWT_CHAVE_PRIVADA=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs de cada serviço (recomendado em produção)
DOCS=1
